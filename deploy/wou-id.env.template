# World of Unreal Identity Server Configuration
WOU_HOST=127.0.0.1
WOU_PORT=25570

# Storage: Valkey (DB 1) & Redb (Durable embedded DB)
WOU_REDIS_URL=redis://127.0.0.1:6379/1
WOU_REDB_PATH=/var/db/wou-id/wou_accounts.redb

# Security: JWT Signing Secret (32+ characters, server env only, never commit real values)
WOU_JWT_SECRET=REPLACE_ME_IN_PROD_ENV

# Stalwart SMTPS (Port 465)
WOU_SMTP_HOST=mail.worldofunreal.com
WOU_SMTP_PORT=465

# Domain Specific SMTPS Passwords for Multi-Tenant Dispatch (server env only, never commit real values)
WOU_SMTP_PASS_WORLDOFUNREAL=REPLACE_ME_IN_PROD_ENV
WOU_SMTP_PASS_SHADOWSOFWAR=REPLACE_ME_IN_PROD_ENV
WOU_SMTP_PASS_COSMICRAFTS=REPLACE_ME_IN_PROD_ENV
WOU_SMTP_PASS_DARKRIFT=REPLACE_ME_IN_PROD_ENV
WOU_SMTP_PASS_NFTROPOLY=REPLACE_ME_IN_PROD_ENV

# OTP Expiry (10 minutes)
WOU_OTP_EXPIRY_SECONDS=600

# Optional ops inbox for abuse alerts (ban/penalty/IP-block/protection events).
# Unset = log-only. Delivered from no-reply@worldofunreal.com as [WOU-ALERT].
WOU_ADMIN_ALERT_EMAIL=

# Social OAuth2 Credentials (Optional / Fill when configured in developer consoles)
WOU_DISCORD_CLIENT_ID=
WOU_DISCORD_CLIENT_SECRET=
WOU_GOOGLE_CLIENT_ID=
WOU_GOOGLE_CLIENT_SECRET=
WOU_TWITTER_CLIENT_ID=
WOU_TWITTER_CLIENT_SECRET=
WOU_META_CLIENT_ID=
WOU_META_CLIENT_SECRET=

# Bot push approval (Telegram first, Discord second; secrets live only in prod env 0600)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
