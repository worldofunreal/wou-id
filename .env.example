# ==============================================================================
# World of Unreal ID (WOU-ID) — Configuration Environment
# ==============================================================================

# Server Network
WOU_HOST=0.0.0.0
WOU_PORT=25570
WOU_PUBLIC_URL=https://id.worldofunreal.com

# Database & Cache
WOU_REDIS_URL=redis://127.0.0.1:6379/0
WOU_REDB_PATH=/var/db/wou-id/wou_accounts.redb

# Security & JWT
WOU_JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_string
WOU_OTP_EXPIRY_SECONDS=600

# Stalwart Mail Engine (Transactional Dispatch)
WOU_SMTP_HOST=mail.worldofunreal.com
WOU_SMTP_PORT=465
WOU_SMTP_USER=no-reply@worldofunreal.com
WOU_SMTP_PASSWORD=ni*5lC673XuaPjDmPk3QAgqd
WOU_SMTP_FROM_NAME=World of Unreal ID

# Supported Game Domains & SMTP Senders
WOU_SOW_SENDER=no-reply@shadowsofwar.io
WOU_COSMICRAFTS_SENDER=no-reply@cosmicrafts.com
WOU_DARKRIFT_SENDER=no-reply@darkrift.ai
WOU_NFTROPOLY_SENDER=no-reply@nftropoly.com

# External Portals (Optional API Keys for Verification)
CRAZYGAMES_API_KEY=
POKI_API_KEY=
